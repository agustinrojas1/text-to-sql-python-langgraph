# --- Database (docker-compose.yml, host port 5433) ---
T2SQL_ADMIN_DATABASE_URL=postgresql://t2sql_admin:t2sql_admin@localhost:5433/chinook
T2SQL_READONLY_DATABASE_URL=postgresql://t2sql_reader:t2sql_reader@localhost:5433/chinook

# --- Guardrails ---
T2SQL_STATEMENT_TIMEOUT_MS=5000
T2SQL_MAX_ROWS=100
# JSON list; defaults to the Chinook tables
# T2SQL_ALLOWED_TABLES=["album","artist","customer","employee","genre","invoice","invoice_line","media_type","playlist","playlist_track","track"]

# --- LLM providers ---
# Tried in order; providers without an API key are skipped (at least one key is required).
T2SQL_LLM_PROVIDERS=gemini,groq
GOOGLE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Model ids (defaults shown)
# T2SQL_GEMINI_MODEL=gemini-3.5-flash-lite
# T2SQL_GROQ_MODEL=openai/gpt-oss-120b
# T2SQL_ANTHROPIC_MODEL=claude-haiku-5-5
# T2SQL_LLM_TIMEOUT_S=30
# T2SQL_LLM_MAX_RETRIES=3
# Sampling temperature (default 0; ignored by Gemini models with fixed sampling)
# T2SQL_LLM_TEMPERATURE=0

# --- Scope classifier (optional local "System 1" model, see README) ---
# llm = the cloud LLM decides (default) | local = local model only | cascade = local when confident
# T2SQL_CLASSIFIER=llm
# Model served by llama-server: tev1 (Tev1-4B GGUF, /completion) | d1 (LiquidAI d1-3B GGUF, /v1/systemone)
# T2SQL_LOCAL_CLASSIFIER_MODEL=tev1
# T2SQL_LOCAL_CLASSIFIER_URL=http://127.0.0.1:8090
# T2SQL_LOCAL_CLASSIFIER_TIMEOUT_S=2
# "local": P(in scope) >= threshold means in scope
# T2SQL_LOCAL_THRESHOLD=0.5
# "cascade": P < LOW is out of scope, P > HIGH is in scope, in between asks the cloud LLM.
# Defaults were chosen on a dev split of the scope benchmark (0 confident errors on the test split,
# ~50% decided locally); see docs/adr/0005. Raising LOW or lowering HIGH decides more locally but risks errors.
# T2SQL_CASCADE_LOW=0.10
# T2SQL_CASCADE_HIGH=0.93

# --- Schema RAG (run `uv run t2sql index` once) ---
# auto = pgvector if the index exists, else all tables (with a warning); or pgvector | all
# T2SQL_RETRIEVER=auto
# T2SQL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Where the ~240 MB embedding model is cached (default: $FASTEMBED_CACHE_PATH, else ~/.cache/t2sql/fastembed)
# T2SQL_EMBEDDING_CACHE_DIR=~/.cache/t2sql/fastembed
# T2SQL_RETRIEVAL_TOP_K=5
# Weight of the keyword (lexical) score added to the embedding score; 0 = embeddings only
# T2SQL_RETRIEVAL_LEXICAL_WEIGHT=0.5

# --- Repair loop and tracing ---
# T2SQL_MAX_REPAIRS=2
# T2SQL_TRACE_FILE=traces.jsonl
# Extra/override prices in USD per 1M tokens: {"model": [input, output]}
# T2SQL_MODEL_PRICES={"my-model": [0.1, 0.4]}
